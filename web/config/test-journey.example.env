# Development-only customer/factory journey. Never put real customer recipients here.
QUOTESUITE_TEST_JOURNEY=1
QUOTESUITE_TEST_CUSTOMER_EMAIL=customer-test@example.test
QUOTESUITE_TEST_FACTORY_EMAIL=factory-test@example.test

# Keep 0 for previews and local workflow acceptance. Set to 1 only after the two
# designated test mailboxes are approved and a controlled delivery run is intended.
QUOTESUITE_TEST_DELIVERY_ENABLED=0
